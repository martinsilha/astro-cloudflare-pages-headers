{
  "branches": [
    {
      "name": "dev",
      "prerelease": true
    },
    {
      "name": "main"
    }
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/npm",
      {
        "npmPublish": false,
        "tarballDir": ".release-artifacts"
      }
    ],
    [
      "./scripts/semantic-release-exact-artifact.mjs",
      {
        "tarballDir": ".release-artifacts",
        "evidenceRoot": ".release-evidence",
        "matrixPath": "fixtures/astro-consumer/compatibility-matrix.json"
      }
    ],
    "@semantic-release/github",
    "@semantic-release/git"
  ]
}
